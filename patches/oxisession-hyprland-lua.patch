+    #[test]
+    fn supervised_compositor_must_belong_to_the_launcher_process_group() {
+        let mut launcher = Command::new("sleep")
+            .arg("30")
+            .process_group(0)
+            .spawn()
+            .unwrap();
+        let mut compositor = Command::new("sleep")
+            .arg("30")
+            .process_group(launcher.id() as i32)
+            .spawn()
+            .unwrap();
+        let instances = serde_json::json!([
+            {"instance":"owned","pid":compositor.id()},
+            {"instance":"desktop","pid":std::process::id()}
+        ]);
+        let owned = owns_instance(&instances, "owned", launcher.id());
+        let foreign = owns_instance(&instances, "desktop", launcher.id());
+        compositor.kill().unwrap();
+        compositor.wait().unwrap();
+        launcher.kill().unwrap();
+        launcher.wait().unwrap();
+        assert!(owned);
+        assert!(!foreign);
+    }
